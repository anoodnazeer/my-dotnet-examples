@page
@model HotelBookingSystem.Pages.Hotel.ListModel
@{
    <h1>All Rooms</h1>
    <p><a asp-page="Create">Add New Room</a></p>
    <table class="table">
        <thead><tr><th>#</th><th>Number</th><th>Type</th><th>Price</th><th>Available</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var r in Model.Rooms)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@r.RoomNumber</td>
                    <td>@r.RoomType</td>
                    <td>@r.Price</td>
                    <td>@r.IsAvailable</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@r.Id">Edit</a> |
                        <a asp-page="Delete" asp-route-id="@r.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
